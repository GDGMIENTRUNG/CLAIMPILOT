DATABASE_URL=postgresql+psycopg://claimpilot:replace-with-local-password@localhost:5432/claimpilot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_QUERY=in:inbox newer_than:30d {complaint issue problem refund return replacement damaged broken defective missing lost "not received" late delayed wrong incorrect overcharged "khiếu nại" "phàn nàn" "vấn đề" "hoàn tiền" "đổi trả" "thay thế" "hư hỏng" "thất lạc" "chưa nhận" "giao trễ" "giao sai" "tính phí sai"}
FRONTEND_ORIGIN=http://localhost:5173
GMAIL_BATCH_SIZE=10
GMAIL_RETRY_FAILED=false
GEMINI_TIMEOUT_SECONDS=30
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
