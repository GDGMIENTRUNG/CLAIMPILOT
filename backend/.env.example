DATABASE_URL=postgresql+psycopg://claimpilot:replace-with-local-password@localhost:5432/claimpilot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_QUERY=in:inbox newer_than:30d {subject:complaint subject:"refund request" subject:"late delivery" subject:"wrong item" subject:"not received" "khiếu nại" "phàn nàn" "giao trễ" "giao sai" "chưa nhận được hàng" "hàng bị hư hỏng"}
FRONTEND_ORIGIN=http://localhost:5173
GMAIL_BATCH_SIZE=10
GMAIL_RETRY_FAILED=false
GEMINI_TIMEOUT_SECONDS=30
AI_PROVIDER=gemini
GROQ_API_KEY=
