# Copy to infra/cloud-run.env (gitignored). No credentials in this file.
PROJECT_ID=claimpilot-513010
REGION=asia-southeast1
SERVICE=claimpilot
SQL_INSTANCE=claimpilot-db
SQL_DATABASE=claimpilot
REPOSITORY=claimpilot
# Globally unique. Change if the existing name is owned by someone else.
BUCKET=claimpilot-513010-evidence
# Set a unique release tag after build, e.g. base-20261114-01. Never reuse it.
IMAGE_TAG=
DB_RUNTIME_SECRET_VERSION=1
DB_MIGRATOR_SECRET_VERSION=1
# Leave optional versions empty until actual credentials are supplied.
GEMINI_SECRET_VERSION=
GROQ_SECRET_VERSION=
GMAIL_SECRET_VERSION=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
